{
	"name": "@stepperize/react",
	"version": "8.0.0",
	"private": false,
	"publishConfig": {
		"access": "public"
	},
	"description": "The library for building step-by-step workflows for React and React Native apps",
	"author": "damianricobelli",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/damianricobelli/stepperize.git",
		"directory": "packages/react"
	},
	"homepage": "https://stepperize.com",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./primitives": {
			"types": "./dist/primitives/index.d.ts",
			"import": "./dist/primitives/index.js",
			"default": "./dist/primitives/index.js"
		},
		"./headless": {
			"types": "./dist/headless.d.ts",
			"import": "./dist/headless.js",
			"default": "./dist/headless.js"
		}
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"lint": "biome lint src",
		"prepublishOnly": "pnpm run build",
		"clean": "rm -rf .turbo && rm -rf node_modules dist",
		"test": "vitest run",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
	},
	"dependencies": {
		"@stepperize/core": "workspace:*"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0"
	},
	"devDependencies": {
		"@types/react": "catalog:",
		"react": "catalog:",
		"tsup": "catalog:",
		"typescript": "catalog:legacy-tooling",
		"vitest": "catalog:",
		"react-dom": "catalog:",
		"@types/react-dom": "catalog:",
		"@typescript/native": "catalog:",
		"vite": "catalog:",
		"vitest-browser-react": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"playwright": "catalog:",
		"@vitejs/plugin-react": "catalog:"
	}
}
