{
	"name": "@stepperize/lit",
	"version": "0.0.0",
	"private": false,
	"publishConfig": {
		"access": "public"
	},
	"description": "The library for building step-by-step workflows for Lit and web components",
	"author": "damianricobelli",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/damianricobelli/stepperize.git",
		"directory": "packages/lit"
	},
	"homepage": "https://stepperize.com",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./headless": {
			"types": "./dist/headless.d.ts",
			"import": "./dist/headless.js",
			"default": "./dist/headless.js"
		}
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"lint": "biome lint src",
		"prepublishOnly": "pnpm run build",
		"clean": "rm -rf .turbo && rm -rf node_modules dist",
		"test": "vitest run",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
	},
	"dependencies": {
		"@stepperize/core": "workspace:*"
	},
	"peerDependencies": {
		"lit": "^3.0.0"
	},
	"devDependencies": {
		"@lit-labs/ssr": "^4.1.0",
		"@typescript/native": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"axe-core": "4.14.0",
		"lit": "^3.3.0",
		"playwright": "catalog:",
		"tsup": "catalog:",
		"typescript": "catalog:legacy-tooling",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
