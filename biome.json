{
	"$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
	"files": {
		"includes": [
			"**",
			"!.turbo",
			"!**/.next",
			"!**/.source",
			"!.changeset",
			"!.pnpm-store",
			"!packages/*/dist",
			"!apps/docs/src/lib/benchmark-results.json"
		]
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"formatter": {
		"lineWidth": 120
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"markdown": {
		"formatter": {
			"enabled": false
		}
	},
	"yaml": {
		"formatter": {
			"enabled": false
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": {
				"useKeyWithClickEvents": "off"
			},
			"nursery": {
				"useTailwindSortedClasses": "off"
			},
			"style": {
				"useBlockStatements": "off"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noArrayIndexKey": "off",
				"noConsole": { "level": "error", "options": { "allow": ["log"] } }
			},
			"correctness": {
				"noUnusedVariables": "error",
				"noUnusedImports": "error",
				"useExhaustiveDependencies": "off"
			},
			"complexity": {
				"noBannedTypes": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["packages/react/src/**"],
			"linter": {
				"rules": {
					"correctness": {
						"noComponentHookFactories": "off"
					}
				}
			}
		}
	]
}
