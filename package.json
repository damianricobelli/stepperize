{
	"name": "stepperize",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/damianricobelli/stepperize.git"
	},
	"scripts": {
		"build": "turbo build",
		"dev": "pnpm build:packages && turbo dev",
		"lint": "turbo lint",
		"clean": "turbo run clean && rm -rf node_modules .pnpm-store .turbo",
		"format-and-lint": "biome check .",
		"format-and-lint:fix": "biome check . --write",
		"ci:version": "changeset version",
		"ci:release": "changeset publish",
		"typecheck": "turbo typecheck",
		"test": "turbo test",
		"check": "pnpm typecheck && pnpm test && pnpm build",
		"build:packages": "turbo build --filter=@stepperize/react...",
		"benchmark": "node scripts/benchmarks/compare.mjs",
		"benchmark:size": "pnpm build:packages && node scripts/check-bundle.mjs",
		"test:install": "pnpm --filter @stepperize/react exec playwright install chromium --only-shell"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@changesets/changelog-github": "1.0.1",
		"@changesets/cli": "^3.0.3",
		"turbo": "2.10.13",
		"typescript": "catalog:"
	},
	"packageManager": "pnpm@10.28.0",
	"engines": {
		"node": "^22.22.2 || ^24.15.0 || >=26.0.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"msw"
		]
	}
}
